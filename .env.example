# Copy to .env.local for local development. On Vercel, set these in project env.

# Postgres connection string. Local dev: postgresql://USER@localhost:5432/casespace
# Production: the Neon pooled connection string (postgresql://...neon.tech/...).
DATABASE_URL=

# Auth.js session secret. Generate one:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Google OAuth client (Google Cloud Console → OAuth 2.0 Client ID, web app).
# Authorized redirect URI: {origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev-only: set to 1 to enable the email-only dev sign-in form on /signin.
# Only honored when NODE_ENV !== "production".
AUTH_DEV_LOGIN=

# Vercel AI Gateway API key (Vercel dashboard → AI Gateway). Powers the Coach,
# intake parsing, and the weekly What's New draft. Without it, AI features
# show a setup notice; the rest of the app works fully.
AI_GATEWAY_API_KEY=

# Shared secret for Vercel Cron requests to /api/cron/*.
CRON_SECRET=

# Optional: canonical origin for the MCP/REST snippets shown on /profile.
# Left unset, the app derives it from the request headers — usually right.
NEXT_PUBLIC_APP_URL=
